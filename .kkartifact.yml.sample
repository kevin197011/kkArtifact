# Agent 配置示例 — 复制为 .kkartifact.yml
server_url: https://packages.slileisure.com
token: YOUR_TOKEN_HERE
project: g02                    # 默认项目，push / push-tree 可省略 --project
concurrency: 50                 # 本地 30–50，远程 50–100
chunk_size: 4MB
retain_versions: 5
ignore: []
  # - logs/
  # - tmp/
  # - '*.log'
  # - node_modules/
