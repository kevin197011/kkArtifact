# kkArtifact 环境变量模板
# 复制为 .env 后按环境修改；本地开发建议 STORAGE_TYPE=local

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kkartifact
DB_USER=kkartifact
DB_PASSWORD=kkartifact
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Storage ---
# 本地开发：STORAGE_TYPE=local
# 生产 / MinIO：STORAGE_TYPE=s3
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=/repos
STORAGE_BASE_PATH=/repos
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET=kkartifact
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false

# --- 版本与认证 ---
VERSION_RETENTION_LIMIT=5
# JWT_SECRET=                          # 不设置则随机生成
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# SKIP_ADMIN_USER=false
# ADMIN_TOKEN=                         # 可选：预置管理员 Token
# ENABLE_SWAGGER=true

# --- 日志 ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Web UI ---
# WEB_UI_PORT=3000
# VITE_API_URL=/

# --- 生产镜像（docker-compose.prod.yml）---
# KK_SERVER_IMAGE=ghcr.io/kevin197011/kkartifact/server:v1.0.0
# KK_WEB_UI_IMAGE=ghcr.io/kevin197011/kkartifact/web-ui:v1.0.0
